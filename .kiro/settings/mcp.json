{
  "mcpServers": {
    "firebase": {
      "command": "firebase",
      "args": ["mcp"],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": false,
      "autoApprove": [
        "firebase-get-config",
        "firebase-list-projects",
        "firebase-get-database-data",
        "firebase-list-collections"
      ]
    }
  }
}